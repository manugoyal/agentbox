# Explicit opt-in for namespace capabilities used by agentbox --docker.
# A tiny, root-owned entrypoint enters this profile. Bubblewrap inherits it;
# Ubuntu's system-wide bwrap and unprivileged-userns restrictions are unchanged.
# Filesystem/process containment is enforced by agentbox's nested namespaces.
abi <abi/4.0>,
include <tunables/global>

profile agentbox-docker /usr/local/libexec/agentbox-bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow /** ix,
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  userns,
}
