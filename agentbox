        "allowWrite": [
            # Writes are allow-only, so the terminal devices have to be named. A
            # full-screen TUI writes escape sequences to /dev/tty and cannot
            # enter raw mode without it: the symptom is garbled output and keys
            # that do nothing. This mirrors the set Claude Code's own sandbox
            # allows.
            "/dev/stdout",
            "/dev/stderr",
            "/dev/null",
            "/dev/tty",
            "/dev/dtracehelper",
            "/dev/autofs_nowait",
            ".",
