"""Run an explicitly named command inside an srt sandbox.

The child receives only an allowlisted host environment plus credentials selected
through command-line options or the agentbox config file.
"""

from __future__ import annotations

import argparse
import copy
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any, NoReturn

import tomllib

DEFAULT_CONFIG_PATH = Path(
    os.environ.get("AGENTBOX_CONFIG") or Path.home() / ".config/agentbox.toml"
)

# The sandbox policy travels with this script, so there is one file to copy
# around. Override it with --settings to use a policy file on disk instead, or
# dump it with --print-settings to start one.
#
# Reads are deny-then-allow and writes are allow-only, so denying $HOME and
# listing a few directories is enough: credential stores you have not thought of
# — ~/.aws, ~/Library/Keychains, 1Password's group container, whatever you log
# into next month — are denied without being named. Relative paths resolve
# against the working directory, which is what keeps this policy project-neutral.
SRT_SETTINGS: dict[str, Any] = {
    "filesystem": {
        "denyRead": ["~"],
        "allowRead": [
            ".",
            "~/.claude",
            "~/.claude.json",
            "~/.codex",
            "~/.local",
            "~/.cache",
            "~/Library/Caches",
            "~/.gitconfig",
            "~/.zshenv",
            "~/.zprofile",
