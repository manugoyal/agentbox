# Passed through to the sandboxed process. Everything else is dropped, so no
# AWS_PROFILE pointing at an admin role and no SSH_AUTH_SOCK offering your keys.
#
# The terminal and locale groups matter more than they look: a full-screen TUI
# renders as garbage without the right TERM and a terminfo entry it can find, and
# without a UTF-8 locale the runtime falls back to ASCII and mangles both the
# box-drawing output and the keys you type.
PASSTHROUGH_ENV_VARS = (
    # Process basics.
    "HOME",
    "PATH",
    "SHELL",
    "USER",
    "LOGNAME",
    "TMPDIR",
    "PWD",
    # Terminal.
    "TERM",
    "TERMINFO",
    "TERMINFO_DIRS",
    "COLORTERM",
    "TERM_PROGRAM",
    "TERM_PROGRAM_VERSION",
    "TMUX",
    "TMUX_PANE",
    # Locale.
    "LANG",
    "LC_ALL",
    "LC_CTYPE",
)

PRIVILEGED_MARKERS = ("Administrator", "FullAccess", "PowerUser", ":root")

# srt sets TMPDIR to this for the sandboxed process but does not create it, so
# anything that writes a temp file fails with ENOENT rather than a permission
# error. It sits under /tmp, which the policy already allows writing, so creating
# it is enough. Recreated per launch because /tmp is cleared periodically.
SRT_TMPDIR = Path("/tmp/claude")

# Config directories the sandbox gets instead of the real ones under ~/.config,
# which stay denied. This is not just about the read failing: ~/.config/gh holds
# a personal OAuth token with your full account scope, so granting it would
# undo the point of injecting a read-only PAT. Pointing each tool at its own
# directory keeps it working off the credential we passed in, and gh exits even
# for --version if it cannot read a config, so this is the difference between
# working and not. Under ~/.cache, which the policy already allows both ways, so
# settings survive between launches.
TOOL_CONFIG_DIRS = {
    "GH_CONFIG_DIR": Path.home() / ".cache/agentbox/gh",
}


def die(message: str) -> NoReturn:
    print(f"agentbox: {message}", file=sys.stderr)
    raise SystemExit(1)


# Recognized config keys, mapped to the environment variable that overrides
# each. Unknown keys are an error: a typo should not silently give you a wider
# credential than you meant to launch with.
CONFIG_ENV_VARS = {
    "aws_profile": "AGENTBOX_AWS_PROFILE",
    "aws_region": "AGENTBOX_AWS_REGION",
    "srt_settings": "AGENTBOX_SRT_SETTINGS",
}

# Asked about only when there is no config file, to keep a first run useful.
PROMPTED_SECRETS = ("GH_TOKEN", "BRAINTRUST_API_KEY")

EXAMPLE_CONFIG = """\
# agentbox defaults. Every key is optional, but a file that exists is
# authoritative: agentbox will not prompt for anything it leaves out.

# AWS profile to exchange for temporary credentials on the host. Use a
# read-only profile: it, not the sandbox, is what bounds what AWS calls can do.
aws_profile = "development-readonly"

# Region for those credentials.
aws_region = "us-east-1"

# An srt policy file to use instead of the one embedded in the script. Start one
# from `agentbox --print-settings`.
# srt_settings = "~/.srt.json"

# Environment variables to inject, each from a 1Password reference. A value may
# be an op:// path, or $VAR naming a variable that holds one — which keeps the
# reference in your shell profile and the secret in 1Password.
[secrets]
GH_TOKEN = "$GH_TOKEN_REFERENCE"
BRAINTRUST_API_KEY = "op://Private/braintrust/api-key"

# Plain environment variables — nothing secret, since this file is not encrypted.
# Use this for context a tool would otherwise read from a config file that the
# sandbox cannot access. Applied before secrets, so it cannot shadow an injected
# credential.
[env]
# SERVICE_ORG = "example-org"
# SERVICE_PROJECT = "example-project"
"""


class Config:
    """Load defaults from a TOML file; see --print-config for the format."""

    def __init__(self, path: Path, *, required: bool = False) -> None:
        self.path = path
        self.exists = path.is_file()
        self.secrets: dict[str, str] = {}
        self.env: dict[str, str] = {}
        self._values: dict[str, str] = {}

        if not self.exists:
            if required:
                die(f"no config file at {path}")
            return
        try:
            data = tomllib.loads(path.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, tomllib.TOMLDecodeError) as error:
            die(f"could not read {path}: {error}")

        for table, target, shape in (
            ("secrets", self.secrets, 'NAME = "op://..."'),
            ("env", self.env, 'NAME = "value"'),
        ):
            entries = data.pop(table, {})
            if not isinstance(entries, dict):
                die(f"{path}: [{table}] must be a table of {shape} entries")
            for name, value in entries.items():
                if not isinstance(value, str):
                    die(
                        f"{path}: [{table}] {name} must be a string, "
                        f"not {type(value).__name__}"
                    )
                target[name] = value

        for key, value in data.items():
            if key not in CONFIG_ENV_VARS:
                known = ", ".join(sorted(CONFIG_ENV_VARS))
                die(
                    f"{path}: unknown key {key!r}; expected one of {known}, "
                    "or the [secrets] / [env] tables"
                )
            if not isinstance(value, str):
                die(f"{path}: {key} must be a string, not {type(value).__name__}")
            self._values[key] = value

    def get(self, key: str, default: str = "") -> str:
        """Resolve one setting: environment first, then the config file."""
        env_var = CONFIG_ENV_VARS[key]
        if env_var in os.environ:
            return os.environ[env_var]
        return self._values.get(key, default)


def prompt(message: str) -> str:
    try:
        return input(message).strip()
    except EOFError:
        return ""


def run_checked(
    argv: list[str], *, env: dict[str, str | None] | None = None
) -> str:
    """Run a command and return stdout, raising with its stderr on failure.

    `env` overlays the current environment. A None value removes the variable,
    which is not the same as setting it empty: an empty AWS_PROFILE makes the AWS
    CLI look for a profile named "" rather than falling back to explicit keys.
    """
    overlaid: dict[str, str] | None = None
    if env is not None:
        overlaid = dict(os.environ)
        for key, value in env.items():
            if value is None:
                overlaid.pop(key, None)
            else:
                overlaid[key] = value

    result = subprocess.run(argv, capture_output=True, text=True, env=overlaid)
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout).strip())
    return result.stdout


def export_aws_credentials(profile: str, region: str) -> tuple[dict[str, str], str]:
    """Exchange an AWS profile for temporary credentials, and report the identity."""
    if shutil.which("aws") is None:
        die("aws CLI is not installed, but --profile was given")

    # --profile outranks the environment, but an ambient AWS_PROFILE set to the
    # empty string is the kind of state that produces confusing errors, so drop
    # it and let the explicit flag be the only input.
    profile_env: dict[str, str | None] = {
        "AWS_PROFILE": None,
        "AWS_DEFAULT_PROFILE": None,
    }
    try:
        exported = run_checked(
            [
                "aws",
                "configure",
                "export-credentials",
                "--profile",
                profile,
                "--format",
                "env-no-export",
            ],
            env=profile_env,
        )
    except RuntimeError as error:
        die(
            f"could not export credentials for profile {profile!r}: {error}\n"
            f"         if it is an SSO profile, try: aws sso login --profile {profile}"
        )

    credentials: dict[str, str] = {}
    for line in exported.splitlines():
        key, separator, value = line.partition("=")
        if separator and key.startswith("AWS_"):
            credentials[key.strip()] = value.strip()

    if "AWS_ACCESS_KEY_ID" not in credentials:
        die(f"profile {profile!r} produced no access key")

    credentials["AWS_REGION"] = region
    credentials["AWS_DEFAULT_REGION"] = region

    try:
        # Drop ambient profile and config selectors so this verifies the
        # exported credentials themselves.
        verify_env: dict[str, str | None] = dict(credentials)
        for name in (
            "AWS_PROFILE",
            "AWS_DEFAULT_PROFILE",
            "AWS_CONFIG_FILE",
            "AWS_SHARED_CREDENTIALS_FILE",
        ):
            verify_env[name] = None
        identity = run_checked(
            ["aws", "sts", "get-caller-identity", "--query", "Arn", "--output", "text"],
            env=verify_env,
        ).strip()
    except RuntimeError as error:
        die(f"the exported credentials for {profile!r} do not work: {error}")

    if any(marker in identity for marker in PRIVILEGED_MARKERS):
        print(
            f"agentbox: WARNING: {identity} looks privileged, not read-only.",
            file=sys.stderr,
        )
    return credentials, identity


def resolve_reference(raw: str) -> str:
    """Turn a `$VAR` or `${VAR}` indirection into the op:// reference it holds.

    Shells expand `$VAR` before we ever see it, but a reference typed at our own
    prompt or written in the config file does not go through a shell — so accept
    the form explicitly. The variable holds the *reference*, not the secret, which
    is why keeping these in a shell profile is safe.
    """
    text = raw.strip()
    if not text.startswith("$"):
        return text

    name = text[1:]
    if name.startswith("{") and name.endswith("}"):
        name = name[1:-1]
    if not name:
        die(f"{raw!r} names no environment variable")

    value = os.environ.get(name, "").strip()
    if not value:
        die(f"${name} is unset or empty, so there is no reference to read")
    return value


def read_secrets(specs: list[str]) -> dict[str, str]:
    """Resolve `NAME=op://...` specs with the host's op, never inside the sandbox."""
    if not specs:
        return {}
    if shutil.which("op") is None:
        die("op is not installed, but secrets were requested")

    secrets: dict[str, str] = {}
    for spec in specs:
        name, separator, raw_reference = spec.partition("=")
        if not separator or not name or not raw_reference:
            die(f"bad secret {spec!r}, expected NAME=op://... or NAME=$VAR")

        reference = resolve_reference(raw_reference)
        if not reference.startswith("op://"):
            die(
                f"{name} resolved to {reference!r}, which is not an op:// reference.\n"
                "         Pass an op:// path, or $VAR naming a variable that holds one."
            )
        try:
            secrets[name] = run_checked(["op", "read", reference]).strip()
        except RuntimeError as error:
            die(f"could not read {reference}: {error}\n         is op signed in?")
    return secrets


def materialize_settings() -> Path:
    """Write the embedded policy to a stable temp path and return it.

    Stable rather than unique so repeated launches do not litter, and rewritten
    on every launch so edits to this script take effect and so a tampered copy
    cannot survive into the next run. srt reads it before the sandbox exists, so
    the sandboxed process never needs read access to it.
    """
    policy = copy.deepcopy(SRT_SETTINGS)
    # The policy lives in this script, and the working directory is writable, so
    # without this the sandboxed process could rewrite its own cage for the next
    # launch. Resolved because denyWrite matches paths, not inodes.
    policy["filesystem"]["denyWrite"].append(str(Path(__file__).resolve()))

    path = Path(tempfile.gettempdir()) / "agentbox-srt-settings.json"
    path.write_text(json.dumps(policy, indent=2) + "\n", encoding="utf-8")
    path.chmod(0o600)
    return path


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="agentbox",
        description="Run a command inside srt with only the credentials you name.",
        epilog=(
            f"Defaults come from {DEFAULT_CONFIG_PATH} unless -c says otherwise. "
            "Run --print-config for a commented example."
        ),
    )
    parser.add_argument(
        "-c",
        "--config",
        metavar="PATH",
        help=f"TOML config file with defaults (default: {DEFAULT_CONFIG_PATH})",
    )
    parser.add_argument(
        "-p",
        "--profile",
        help="AWS profile to exchange for temporary credentials",
    )
    parser.add_argument("-r", "--region", help="AWS region (default: us-east-1)")
    parser.add_argument(
        "-s",
        "--secret",
        action="append",
        default=[],
        metavar="NAME=REF",
        help=(
            "Extra secret: environment variable NAME from a 1Password reference. "
            "REF is an op:// path, or $VAR naming a variable that holds one."
        ),
    )
    parser.add_argument(
        "--settings",
        help="srt settings file to use instead of the policy embedded in this script",
    )
    parser.add_argument(
        "--print-settings",
        action="store_true",
        help="Print the embedded srt policy and exit",
    )
    parser.add_argument(
        "--print-config",
        action="store_true",
        help="Print an example config file and exit",
    )
    parser.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="Skip the confirmation prompt",
    )
    parser.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="Command to run (required; place it after --)",
    )
    return parser


def parse_command(
    parser: argparse.ArgumentParser,
    raw_command: list[str],
) -> list[str]:
    """Consume argparse's separator and validate the child command."""
    command = raw_command[1:] if raw_command[:1] == ["--"] else raw_command
    if not command:
        parser.error("a command is required; pass it after --")
    return command


def print_launch_summary(
    *,
    settings: Path,
    profile: str,
    identity: str,
    secrets: dict[str, str],
    command: list[str],
) -> None:
    print()
    print(f"  srt settings   {settings}")
    print(f"  aws profile    {profile or '(none)'}")
    print(f"  aws identity   {identity}")
    print(f"  secrets        {' '.join(sorted(secrets)) or '(none)'}")
    print(f"  command        {shlex.join(command)}")
    print()


def confirm_launch(*, skip: bool) -> None:
    if skip:
        return
    try:
        answer = input("Launch? [y/N] ").strip().lower()
    except EOFError:
        answer = ""
    if answer not in {"y", "yes"}:
        die("aborted")


def prepare_runtime_directories() -> None:
    for directory in (SRT_TMPDIR, *TOOL_CONFIG_DIRS.values()):
        try:
            directory.mkdir(parents=True, exist_ok=True)
        except OSError as error:
            print(f"agentbox: could not create {directory}: {error}", file=sys.stderr)


def build_environment(
    config: Config,
    credentials: dict[str, str],
    secrets: dict[str, str],
) -> dict[str, str]:
    environment = {
        name: os.environ[name] for name in PASSTHROUGH_ENV_VARS if name in os.environ
    }
    environment.update({name: str(path) for name, path in TOOL_CONFIG_DIRS.items()})

    # Only pass TMPDIR through if it actually exists and is writable. A stale
    # value — say one left over from another sandbox — makes tools fail with a
    # confusing "no such file or directory" on a temp file rather than anything
    # that points at the environment.
    inherited_tmpdir = environment.get("TMPDIR", "")
    tmpdir_is_usable = (
        inherited_tmpdir
        and os.path.isdir(inherited_tmpdir)
        and os.access(inherited_tmpdir, os.W_OK)
    )
    if not tmpdir_is_usable:
        if inherited_tmpdir:
            print(
                f"agentbox: TMPDIR={inherited_tmpdir} is missing or unwritable; "
                "falling back to /tmp",
                file=sys.stderr,
            )
        environment["TMPDIR"] = "/tmp"

    # A TUI needs a UTF-8 locale to render and read keystrokes correctly, and
    # tmux does not always propagate one.
    if not any(name in environment for name in ("LC_ALL", "LC_CTYPE", "LANG")):
        environment["LANG"] = "en_US.UTF-8"

    # [env] may override the safe defaults above, including GH_CONFIG_DIR.
    # Credentials come last so a plain setting cannot shadow an injected token.
    environment.update(config.env)
    environment.update(credentials)
    environment.update(secrets)
    return environment


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    if args.print_settings:
        print(json.dumps(SRT_SETTINGS, indent=2))
        return

    if args.print_config:
        print(EXAMPLE_CONFIG, end="")
        return

    command = parse_command(parser, args.command)

    # An explicit -c is a claim that the file exists; the default path is not.
    config = Config(
        Path(args.config).expanduser() if args.config else DEFAULT_CONFIG_PATH,
        required=bool(args.config),
    )
    region = args.region or config.get("aws_region", "us-east-1")

    if shutil.which("srt") is None:
        die("srt is not installed or not on PATH")

    override = args.settings or config.get("srt_settings")
    if override:
        settings = Path(override).expanduser()
        if not settings.is_file():
            die(f"no srt settings file at {settings}")
    else:
        settings = materialize_settings()

    # A config file is authoritative: what it does not grant is not granted, and
    # nothing is prompted for. Without one, ask, so a first run still works.
    configured = config.exists

    profile = args.profile or config.get("aws_profile")
    if not profile and not configured:
        profile = prompt("AWS profile (empty for no AWS access): ")

    specs = list(args.secret)
    named = {spec.partition("=")[0] for spec in specs}
    for name, reference in config.secrets.items():
        if name not in named:
            specs.append(f"{name}={reference}")
    if not configured and not specs:
        for name in PROMPTED_SECRETS:
            reference = prompt(
                f"1Password ref for {name}, op:// or $VAR (empty to skip): "
            )
            if reference:
                specs.append(f"{name}={reference}")

    credentials: dict[str, str] = {}
    identity = "(none)"
    if profile:
        credentials, identity = export_aws_credentials(profile, region)
    secrets = read_secrets(specs)

    print_launch_summary(
        settings=settings,
        profile=profile,
        identity=identity,
        secrets=secrets,
        command=command,
    )
    confirm_launch(skip=args.yes)

    prepare_runtime_directories()
    environment = build_environment(config, credentials, secrets)

    # exec replaces this process without flushing, so anything still buffered is
    # lost. Invisible on a terminal, where stdout is line-buffered; when piped it
    # swallows the whole banner.
    sys.stdout.flush()

    # srt takes the command as argv, so pass the words through rather than
    # re-quoting them into one string. The `--` matters: without it srt claims
    # any leading flags for itself, so `gh --version` prints srt's version.
    os.execvpe(
        "srt",
        ["srt", "--settings", str(settings), "--", *command],
        environment,
    )


if __name__ == "__main__":
    main()
