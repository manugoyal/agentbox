{
  "name": "agentbox",
  "version": "0.2.0",
  "description": "Persistent Lima development VMs with host-side credential brokering and a Git exchange",
  "type": "module",
  "bin": {
    "agentbox": "bin/agentbox.js"
  },
  "files": [
    "bin",
    "dist",
    "vm/ubuntu.yaml",
    "vm/session.py",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "check": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:global": "npm run build && npm install --global --install-links .",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "keywords": [
    "agent",
    "vm",
    "lima",
    "credentials",
    "git"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "smol-toml": "^1.3.1",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
