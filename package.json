{
  "name": "agentbox",
  "version": "0.1.0",
  "description": "Run processes in lightweight Linux jails with explicit filesystem and credential grants",
  "type": "module",
  "bin": {
    "agentbox": "bin/agentbox.js"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md",
    "linux"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "check": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:global": "npm run build && npm install --global --install-links .",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "test:docker": "npm run build && AGENTBOX_TEST_DOCKER=1 node --test test/docker.test.js"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "keywords": [
    "agent",
    "sandbox",
    "security",
    "linux",
    "bubblewrap"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "smol-toml": "^1.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
